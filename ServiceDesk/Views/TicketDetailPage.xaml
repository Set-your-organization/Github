<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceDesk.Views.TicketDetailPage"
             Title="Ticket">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="MetaLabel" TextColor="Gray" />
            <Label x:Name="RequesterLabel" />
            <Label x:Name="DescriptionLabel" />
            <Picker x:Name="StatusPicker" Title="Status" SelectedIndexChanged="OnStatusChanged" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
