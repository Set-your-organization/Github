<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceDesk.Views.TicketListPage"
             Title="Tickets">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Clicked="OnNewClicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <Picker x:Name="FilterPicker" Title="Filter by status" SelectedIndexChanged="OnFilterChanged" />
        <CollectionView x:Name="TicketsView" Grid.Row="1" SelectionMode="Single"
                        SelectionChanged="OnTicketSelected">
            <CollectionView.EmptyView>
                <Label Text="No tickets found." HorizontalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="8" Spacing="2">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding Summary}" FontSize="12" TextColor="Gray" />
                        <Label Text="{Binding Requester}" FontSize="12" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
